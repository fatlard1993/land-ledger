{
	"name": "land-ledger",
	"version": "1.0.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "Farm field and lease management",
	"author": "justfatlard",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build": "bun run build:clean && bun run client/build.js",
		"build:clean": "rm -rf ./client/build/",
		"build:watch": "bun run build -- --watch",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"service:enable": "bun scripts/service.js enable",
		"service:disable": "bun scripts/service.js disable",
		"service:start": "bun scripts/service.js start",
		"service:stop": "bun scripts/service.js stop",
		"service:reload": "bun scripts/service.js reload",
		"build:dev": "bun run build && bun run service:reload",
		"cert": "bun scripts/generate-cert.js"
	},
	"dependencies": {
		"@geoman-io/leaflet-geoman-free": "^2.17.0",
		"@turf/area": "^7.3.5",
		"@turf/centroid": "^7.3.5",
		"@turf/dissolve": "^7.3.5",
		"@turf/union": "^7.3.5",
		"@vanilla-bean/components": "^1.0.2",
		"@vanilla-bean/hypertether": "^1.0.0",
		"argi": "github:fatlard1993/argi#fcac703",
		"chart.js": "^4.5.1",
		"leaflet": "^1.9.4",
		"lowdb": "^7.0.1",
		"nanoid": "^5.1.5"
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead",
		"not op_mini all",
		"not kaios 2.5"
	],
	"devDependencies": {
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.30.1",
		"@happy-dom/global-registrator": "^20.9.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"bun-types": "^1.2.18",
		"eslint": "^9.30.1",
		"eslint-plugin-compat": "^6.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^51.3.3",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-unicorn": "^59.0.1",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^16.3.0",
		"prettier": "3.6.2"
	}
}
