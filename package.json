{
	"name": "land-ledger",
	"version": "1.0.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "Farm field and lease management",
	"author": "justfatlard",
	"license": "AGPL-3.0-only",
	"scripts": {
		"prepare": "bun run prepare:githooks",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- push checks will not run')",
		"test": "bun test",
		"build": "bun run build:clean && bun run client/build.js",
		"build:clean": "rm -rf ./client/build/",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"service:enable": "vbc-service enable",
		"service:disable": "vbc-service disable",
		"service:start": "vbc-service start",
		"service:stop": "vbc-service stop",
		"service:reload": "vbc-service reload",
		"service:status": "vbc-service status",
		"service:logs": "vbc-service logs",
		"build:dev": "bun run build && bun run service:reload",
		"cert": "bun scripts/generate-cert.js"
	},
	"dependencies": {
		"@geoman-io/leaflet-geoman-free": "^2.20.0",
		"@turf/area": "^7.3.5",
		"@turf/centroid": "^7.3.5",
		"@turf/dissolve": "^7.3.5",
		"@turf/union": "^7.3.5",
		"@vanilla-bean/components": "^7.0.0",
		"argi-cli": "^1.0.0",
		"chart.js": "^4.5.1",
		"leaflet": "^1.9.4",
		"lowdb": "^7.0.1",
		"nanoid": "^5.1.16"
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead",
		"not op_mini all",
		"not kaios 2.5"
	],
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.14.6",
		"@testing-library/jest-dom": "^6.9.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"happy-dom": "^20.14.6",
		"prettier": "3.6.2"
	}
}
